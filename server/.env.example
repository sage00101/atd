# Secret — never commit real values. Set these in your backend host's environment
# configuration, not in the frontend .env.
YOCO_SECRET_KEY=REPLACE_WITH_YOUR_YOCO_TEST_SECRET_KEY
YOCO_WEBHOOK_SECRET=REPLACE_WITH_YOUR_YOCO_WEBHOOK_SECRET
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
# Optional: Resend webhook signing secret for delivery-status reporting.
RESEND_WEBHOOK_SECRET=REPLACE_WITH_YOUR_RESEND_WEBHOOK_SECRET
SERPAPI_API_KEY=REPLACE_WITH_YOUR_SERPAPI_KEY
# Long random string only you know — required header (x-admin-key) to call
# POST /api/promos/issue. Generate one with: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Separate key for the calendar manager UI at /api/admin/calendar. If left empty,
# the app falls back to ADMIN_API_KEY for calendar access.
CALENDAR_API_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Stable secret used to encrypt secure booking continuation tokens stored in Redis.
# Keep this value unchanged while requests are active; if omitted, ADMIN_API_KEY is used.
BOOKING_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Manage password/promo-code batches in the protected /api/admin/promo-codes UI.
# It uses ADMIN_API_KEY and stores the active batch in the connected Redis database.
# The /api/admin/calendar page lets you block/unblock available timeslots in real time.

# Set these from your Upstash Redis database connection details.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public-ish config, still backend-only.
SITE_URL=https://sage00101.github.io/atd/
ALLOWED_ORIGIN=https://sage00101.github.io,http://localhost:5173
RESEND_FROM_EMAIL=A10tion To Detail <bookings@YOUR-VERIFIED-DOMAIN>
# Optional extra inbox. bookings@a10tion.co.za always receives every receipt regardless.
BUSINESS_EMAIL=bookings@a10tion.co.za
# Business SMS target for confirmed bookings. Default is the requested number: +27 73 306 9217.
BUSINESS_SMS=+27733069217
BUSINESS_SMS_NUMBER=+27733069217
# SMSMessenger (https://smsmessenger.co.za) sends new booking requests and confirmed bookings to BUSINESS_SMS.
# Leave unset to disable SMS. The booking email flow continues without these values.
SMSMESSENGER_EMAIL=REPLACE_WITH_YOUR_SMSMESSENGER_ACCOUNT_EMAIL
SMSMESSENGER_API_KEY=REPLACE_WITH_YOUR_SMSMESSENGER_REST_API_TOKEN
# Google Maps place_id for your business listing (see chat for how to find it)
GOOGLE_PLACE_ID=REPLACE_WITH_YOUR_GOOGLE_PLACE_ID
